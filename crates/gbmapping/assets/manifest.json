{
  "name": "GBMapping",
  "short_name": "GBMapping",
  "description": "A map and tileset editor for Game Boy Advance and Game Boy Color ROMs",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#1b1b1b",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-gba-rom": [".gba"], "application/x-gameboy-color-rom": [".gbc"], "application/x-gameboy-rom": [".gb"] } }
  ]
}
